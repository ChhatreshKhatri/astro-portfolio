---
import GitHub from "../assets/icons/GitHubIcon.astro";
import Gmail from "../assets/icons/GmailIcon.astro";
import LinkedIn from "../assets/icons/LinkedIn.astro";
---

<div class="flex items-center justify-center gap-x-1.5 xs:gap-x-2 sm:gap-x-2.5">
  <a 
    title="GitHub Profile" 
    aria-label="GitHub Profile" 
    href="https://github.com/ChhatreshKhatri" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex items-center justify-center w-8 h-8 xs:w-8.5 xs:h-8.5 lg:w-9 lg:h-9 p-1.5 rounded-full text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200 hover:scale-105 cursor-pointer shrink-0"
  >
    <GitHub class="w-5 h-5 xs:w-5.5 xs:h-5.5 lg:w-6 lg:h-6" aria-hidden="true" />
  </a>
  <a 
    title="LinkedIn Profile" 
    aria-label="LinkedIn Profile" 
    href="https://www.linkedin.com/in/chhatreshkhatri" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex items-center justify-center w-8 h-8 xs:w-8.5 xs:h-8.5 lg:w-9 lg:h-9 p-1.5 rounded-full text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200 hover:scale-105 cursor-pointer shrink-0"
  >
    <LinkedIn class="w-5 h-5 xs:w-5.5 xs:h-5.5 lg:w-6 lg:h-6" aria-hidden="true" />
  </a>
  <a 
    title="Send an Email" 
    aria-label="Send an Email" 
    href="mailto:ck@chhatreshkhatri.com" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="flex items-center justify-center w-8 h-8 xs:w-8.5 xs:h-8.5 lg:w-9 lg:h-9 p-1.5 rounded-full text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200 hover:scale-105 cursor-pointer shrink-0"
  >
    <Gmail class="w-5 h-5 xs:w-5.5 xs:h-5.5 lg:w-6 lg:h-6" aria-hidden="true" />
  </a>
</div>
