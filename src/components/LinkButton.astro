---
import type { LinkButtonProps as Props } from "../types";

const { name, link, imageUrl, loading = "eager" } = Astro.props;
---

<div class="items-center justify-center p-px rounded-xl bg-linear-to-r from-brand-primary/40 to-brand-secondary/40 hover:from-brand-primary hover:to-brand-secondary transition-all duration-300 hover:scale-105 hover:-translate-y-0.5 shadow-xs cursor-pointer group">
  <a 
    title={name} 
    href={link} 
    target="_blank" 
    rel="noopener noreferrer" 
    aria-label={`Visit ${name} (opens in new tab)`}
    class="flex justify-center items-center py-1.5 px-3.5 gap-x-2 rounded-xl whitespace-nowrap bg-white dark:bg-surface-card hover:bg-opacity-95 transition-all duration-300 cursor-pointer"
  >
    <span class="text-xs md:text-sm font-semibold text-gray-800 dark:text-gray-100">{name}</span>
    {imageUrl && (
      <img src={imageUrl} alt="" class="w-3.5 h-3.5 md:w-4 md:h-4 object-contain transition-transform duration-300 group-hover:scale-110" loading={loading} width="16" height="16" aria-hidden="true" />
    )}
  </a>
</div>
