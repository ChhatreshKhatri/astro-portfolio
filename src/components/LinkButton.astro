---
interface Props {
  name: string;
  link: string;
  imageUrl: string;
  pos: number;
  loading?: "eager" | "lazy";
}

const { name, link, imageUrl, pos, loading = "eager" } = Astro.props;
---

<div class={`items-center justify-center p-px rounded-xl bg-linear-to-r ${pos == 1 ? "from-ck2/40 to-ck1/40 hover:from-ck2 hover:to-ck1" : "from-ck1/40 to-ck2/40 hover:from-ck1 hover:to-ck2"} transition-all duration-300 hover:scale-105 hover:-translate-y-0.5 shadow-xs cursor-pointer group`}>
  <a 
    title={name} 
    href={link} 
    target="_blank" 
    rel="noopener noreferrer" 
    aria-label={`Visit ${name} (opens in new tab)`}
    class="flex justify-center items-center py-1.5 px-3.5 gap-x-2 rounded-xl whitespace-nowrap bg-white dark:bg-darker hover:bg-opacity-95 transition-all duration-300 cursor-pointer"
  >
    <img 
      src={imageUrl} 
      alt="" 
      class="w-5 h-5 md:w-6 md:h-6 transition-transform duration-300 group-hover:scale-110" 
      loading={loading}
      width="24"
      height="24"
      aria-hidden="true"
    />
    <span class="text-xs md:text-sm font-semibold text-gray-800 dark:text-gray-100">{name}</span>
  </a>
</div>
