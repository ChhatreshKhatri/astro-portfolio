---
import type { NavLinksProps as Props } from "../types";

const { page, link, ID } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (currentPath === '/' && link === '/') || (link !== '/' && currentPath.startsWith(link));
---

<a 
  id={ID}
  aria-label={`Navigate to ${page}`} 
  href={link} 
  aria-current={isActive ? 'page' : undefined}
  class={`relative flex items-center justify-center px-4 py-1.5 rounded-full text-sm font-semibold transition-all duration-300 cursor-pointer ${
    isActive 
      ? 'bg-linear-to-r from-brand-primary/15 to-brand-secondary/15 text-brand-primary dark:text-brand-secondary shadow-xs border border-brand-primary/20 dark:border-brand-secondary/20' 
      : 'text-gray-700 dark:text-gray-300 hover:text-brand-primary dark:hover:text-brand-secondary hover:bg-black/5 dark:hover:bg-white/5'
  }`}
>
  {page}
</a>
