---
import NavIcons from "./NavIcons.astro";
import NavLinks from "./NavLinks.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import SearchIcon from "../assets/icons/SearchIcon.astro";
---

<header class="fixed top-2.5 sm:top-4 inset-x-0 z-40 flex justify-center px-2 xxs:px-3 xs:px-6 md:px-12 lg:px-20 pointer-events-none">
  <nav 
    id="navBar" 
    class="pointer-events-auto flex flex-col items-center w-full px-3 xxs:px-4 sm:px-6 md:px-8 py-2 rounded-2xl lg:rounded-full bg-white/75 dark:bg-surface-card/80 backdrop-blur-xl border border-black/5 dark:border-white/10 shadow-lg shadow-black/5 dark:shadow-black/20 transition-all duration-300"
    aria-label="Main navigation"
  >
    <div class="flex items-center justify-between w-full min-w-0">
      <!-- Left: Brand Logo -->
      <a aria-label="Chhatresh Khatri - Home Page" href="/" class="flex items-center cursor-pointer transition-transform duration-300 hover:scale-102 min-w-0 flex-1 lg:flex-initial">
        <img
          src="https://cdn.chhatreshkhatri.com/images/ChhatreshKhatri.svg"
          alt="Chhatresh Khatri logo"
          class="block h-5 xs:h-5.5 lg:h-6 w-auto max-w-[170px] xxs:max-w-[200px] xs:max-w-none object-contain"
          width="512"
          height="41"
          title="Chhatresh Khatri"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Center: Navigation Links (Desktop: lg >= 1024px) -->
      <div id="desktopNavLinks" class="hidden lg:flex items-center gap-1 px-2 py-1 rounded-full bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 text-sm font-semibold">
        <NavLinks page="Home" link="/" ID="hover1" />
        <NavLinks page="About" link="/about" ID="hover2" />
        <NavLinks page="Projects" link="/projects" ID="hover3" />
      </div>

      <!-- Right: Actions & Tools -->
      <div class="flex items-center gap-1.5 xs:gap-2 sm:gap-2.5 shrink-0">
        <!-- Desktop Social Icons (Desktop: lg >= 1024px) -->
        <div class="hidden lg:flex items-center">
          <NavIcons />
        </div>

        <div class="hidden lg:block w-px h-4 bg-black/10 dark:bg-white/10 mx-1"></div>

        <!-- Theme Switcher (Same size & color) -->
        <ThemeSwitcher />

        <!-- Search Palette Trigger (Near Menu button) -->
        <button 
          id="searchPaletteTrigger"
          aria-label="Open Search"
          class="flex items-center justify-center w-8 h-8 xs:w-8.5 xs:h-8.5 lg:w-9 lg:h-9 p-1.5 rounded-full text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/10 transition-all duration-200 hover:scale-105 cursor-pointer shrink-0 touch-manipulation"
          title="Search"
        >
          <SearchIcon class="w-5 h-5 xs:w-5.5 xs:h-5.5 lg:w-6 lg:h-6" />
        </button>

        <!-- Mobile / Tablet Hamburger Menu Button (< 1024px) -->
        <button 
          id="menuButton" 
          aria-label="Toggle navigation menu" 
          aria-expanded="false" 
          class="relative flex justify-center items-center lg:hidden cursor-pointer w-8 h-8 xs:w-8.5 xs:h-8.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors shrink-0 touch-manipulation"
        >
          <span id="topBar" class="absolute bg-linear-to-r from-heading-start to-heading-end transition-all duration-300 ease-out h-0.5 w-4.5 xs:w-5 rounded-full -translate-y-1.5"></span>
          <span id="middleBar" class="absolute bg-linear-to-r from-heading-start to-heading-end transition-all duration-300 ease-out h-0.5 w-4.5 xs:w-5 rounded-full opacity-100"></span>
          <span id="bottomBar" class="absolute bg-linear-to-r from-heading-start to-heading-end transition-all duration-300 ease-out h-0.5 w-4.5 xs:w-5 rounded-full translate-y-1.5"></span>
        </button>
      </div>
    </div>

    <!-- Mobile / Tablet Collapsible Menu (< 1024px) -->
    <div id="mobileMenu" class="hidden flex-col items-center w-full pt-3 pb-2 gap-y-3 border-t border-black/5 dark:border-white/10 mt-2 lg:hidden">
      <div class="flex flex-col items-center gap-y-2 text-base font-semibold w-full">
        <NavLinks page="Home" link="/" ID="mobile-hover1" />
        <NavLinks page="About" link="/about" ID="mobile-hover2" />
        <NavLinks page="Projects" link="/projects" ID="mobile-hover3" />
      </div>

      <!-- Mobile / Tablet Social Icons -->
      <div class="flex items-center justify-center pt-1 border-t border-black/5 dark:border-white/10 w-full">
        <NavIcons />
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    let navOpen = false;

    const topBar = document.getElementById("topBar");
    const middleBar = document.getElementById("middleBar");
    const bottomBar = document.getElementById("bottomBar");
    const mobileMenu = document.getElementById("mobileMenu");
    const menuButton = document.getElementById("menuButton");
    const searchTrigger = document.getElementById("searchPaletteTrigger");

    const toggleClasses = (element: HTMLElement | null, addClasses: string[], removeClasses: string[]) => {
      if (element) {
        element.classList.remove(...removeClasses);
        element.classList.add(...addClasses);
      }
    };

    function closeNav() {
      if (!navOpen) return;
      navOpen = false;
      toggleClasses(topBar, ["-translate-y-1.5"], ["rotate-45", "translate-y-0"]);
      toggleClasses(middleBar, ["opacity-100"], ["opacity-0"]);
      toggleClasses(bottomBar, ["translate-y-1.5"], ["-rotate-45", "translate-y-0"]);
      toggleClasses(mobileMenu, ["hidden"], ["flex"]);
      menuButton?.setAttribute("aria-expanded", "false");
    }

    function toggleNav() {
      if (navOpen) {
        closeNav();
      } else {
        navOpen = true;
        toggleClasses(topBar, ["rotate-45", "translate-y-0"], ["-translate-y-1.5"]);
        toggleClasses(middleBar, ["opacity-0"], ["opacity-100"]);
        toggleClasses(bottomBar, ["-rotate-45", "translate-y-0"], ["translate-y-1.5"]);
        toggleClasses(mobileMenu, ["flex"], ["hidden"]);
        menuButton?.setAttribute("aria-expanded", "true");
      }
    }

    menuButton?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleNav();
    });

    // Close when clicking outside of navBar
    document.addEventListener("click", (e: MouseEvent) => {
      const navBar = document.getElementById("navBar");
      if (navOpen && navBar && !navBar.contains(e.target as Node)) {
        closeNav();
      }
    });

    // Close on Escape key press
    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape" && navOpen) {
        closeNav();
      }
    });

    // Close on mobile link click
    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeNav);
    });

    const openSearch = () => {
      if (typeof (window as any).openSearchPalette === "function") {
        (window as any).openSearchPalette();
      }
    };

    searchTrigger?.addEventListener("click", openSearch);
  });
</script>
