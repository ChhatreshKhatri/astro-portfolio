---
import type { HeadingProps as Props } from "../types";

const { as: Tag = "h1", class: classProp, id }: Props = Astro.props;
---
    
<div class={`flex items-center justify-center rounded-xl p-0.5 bg-linear-to-r from-brand-primary/40 to-brand-secondary/40 shadow-lg w-fit max-w-[95vw] xs:max-w-fit mx-auto ${classProp ?? ""}`}>
  <Tag id={id} class="flex justify-center items-center text-center font-extrabold tracking-wide sm:tracking-wider text-lg xxs:text-xl xs:text-2xl md:text-3xl p-1.5 px-3 xs:px-4 sm:px-6 bg-white dark:bg-surface-elevated rounded-[10px] text-gray-900 dark:text-white leading-normal text-balance transition-colors duration-300">
    <slot />
  </Tag>
</div>
