---
interface Props {
  as?: "h1" | "h2" | "div";
  class?: string;
}

const { as: Tag = "h1", class: classProp }: Props = Astro.props;
---
    
<div class={`flex items-center justify-center rounded p-0.5 bg-linear-to-r from-bd1 to-bd2 w-max mx-auto transition duration-400 ease-out starting:opacity-0 starting:-translate-y-2.5 ${classProp ?? ""}`}>
  <Tag class="flex justify-center items-center font-extrabold tracking-wider text-xl xxs:text-2xl md:text-3xl p-1 px-2 bg-white/90 dark:bg-darked rounded">
    <slot />
  </Tag>
</div>
