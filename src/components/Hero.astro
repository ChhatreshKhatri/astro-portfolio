---
import LinkButton from "./LinkButton.astro";
import Highlights from "./Highlights.astro";
import type { HeroProps as Props, LinkItem } from "../types";

const { data } = Astro.props;
const displayLinks: LinkItem[] = data.links || [];
---

<section
  class="hero-section spotlight-card relative group grid grid-cols-1 w-full xl:grid-cols-12 p-6 sm:p-8 md:p-8 gap-6 xl:gap-8 rounded-2xl bg-white/40 dark:bg-surface-card/60 backdrop-blur-md border border-black/5 dark:border-white/10 shadow-2xl transition-all duration-300 ease-out starting:opacity-0 items-center hover:border-brand-primary/40"
  aria-labelledby="hero-heading">
  <div class="absolute inset-0 rounded-2xl bg-linear-to-r from-brand-primary/10 via-purple-500/5 to-brand-secondary/10 opacity-60 transition-opacity duration-300 group-hover:opacity-100 -z-10" aria-hidden="true" />

  <div class="relative order-2 xl:order-1 xl:col-span-8 flex flex-col justify-center items-center xl:items-start text-center xl:text-left gap-4 md:gap-5 z-10">
    <div class="w-full flex flex-col items-center xl:items-start gap-3 md:gap-3.5">
      <h1
        id="hero-heading"
        class="hero-heading flex w-fit text-xl xxs:text-2xl sm:text-3xl md:text-3xl lg:text-4xl font-extrabold bg-linear-to-r from-heading-start to-heading-end bg-clip-text text-transparent leading-tight text-balance transition-colors duration-300 ease-out">
        {data.intro}
      </h1>

      <div
        id="autoTypeContainer"
        data-roles={JSON.stringify(data.roles || ["Full-Stack Software Engineer"])}
        class="hero-typewriter flex items-center justify-center xl:justify-start text-lg sm:text-xl md:text-2xl font-bold min-h-[1.5em] leading-normal transition-colors duration-300 ease-out">
        <span id="autoType" class="bg-linear-to-r from-subheading-start to-subheading-end bg-clip-text text-transparent"></span>
        <span id="cursor" class="inline-block w-0.5 h-[1.1em] bg-linear-to-b from-subheading-start to-subheading-end align-middle animate-pulse ml-1" />
      </div>

      <p class="hero-description text-sm sm:text-base md:text-lg text-gray-700 dark:text-gray-300 text-center xl:text-left leading-relaxed transition-colors duration-300 ease-out max-w-2xl">{data.content}</p>

      <div class="hero-links flex flex-wrap justify-center xl:justify-start items-center gap-2.5 pt-1 w-full transition-colors duration-300 ease-out" aria-label="Social and portfolio links">
        {displayLinks.map((link, index) => (
          <div class="hero-link" data-index={index}>
            <LinkButton name={link.type} link={link.url} imageUrl={link.icon} />
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="hero-image order-1 xl:order-2 xl:col-span-4 flex justify-center items-center z-10">
    <div class="relative w-full flex justify-center items-center group/img py-2 md:py-4">
      <figure class="relative z-10 w-full h-full flex justify-center items-center">
        <img
          title="Chhatresh Khatri"
          src={data.pic}
          alt="Chhatresh Khatri - Full-Stack Software Engineer"
          class="w-full max-w-[260px] sm:max-w-[280px] md:max-w-[300px] xl:max-w-[260px] xxl:max-w-[290px] mx-auto rounded-2xl drop-shadow-2xl transition-transform duration-300 group-hover/img:scale-[1.03] object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="808"
          height="1080"
        />
      </figure>
    </div>
  </div>

  {data.highlights && (
    <div class="relative z-10 order-3 xl:order-3 xl:col-span-12 w-full pt-4 md:pt-6 border-t border-black/5 dark:border-white/10 flex flex-col items-center justify-center gap-3 transition-colors duration-300 ease-out [&>ul]:justify-center">
      <Highlights data={data.highlights} ariaLabel="Core skills highlights" eagerLoad={true} />
    </div>
  )}
</section>

<script>
  let autoTypeTimer: number | undefined;

  document.addEventListener("astro:page-load", () => {
    if (autoTypeTimer) clearTimeout(autoTypeTimer);

    const autoType = document.querySelector("#autoType");
    const container = document.querySelector("#autoTypeContainer") as HTMLElement | null;
    if (!autoType || !container) return;

    const words: string[] = JSON.parse(container.dataset.roles || "[]");
    if (!words.length) return;

    const cursor = document.querySelector("#cursor") as HTMLElement | null;

    // Respect reduced motion preference
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      autoType.textContent = words[0];
      if (cursor) cursor.style.display = "none";
      return;
    }

    let wordIndex = 0;
    let charIndex = 0;
    autoType.textContent = "";

    function typeChar() {
      if (!autoType || !autoType.isConnected) return;
      if (charIndex < words[wordIndex].length) {
        autoType.textContent += words[wordIndex][charIndex++];
        autoTypeTimer = window.setTimeout(typeChar, 80);
      } else {
        autoTypeTimer = window.setTimeout(deleteChar, 2000);
      }
    }

    function deleteChar() {
      if (!autoType || !autoType.isConnected) return;
      if (charIndex > 0) {
        autoType.textContent = words[wordIndex].substring(0, --charIndex);
        autoTypeTimer = window.setTimeout(deleteChar, 40);
      } else {
        wordIndex = (wordIndex + 1) % words.length;
        autoTypeTimer = window.setTimeout(typeChar, 180);
      }
    }

    // Start typing immediately after smooth hero entrance
    autoTypeTimer = window.setTimeout(typeChar, 300);
  });
</script>
