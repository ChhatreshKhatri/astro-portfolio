---
import type { ProjectItem } from "../types";

interface Props {
  project: ProjectItem;
  index?: number;
}

const { project } = Astro.props;
const projectSlug = project.heading.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const liveLink = project.links?.find((l) => l.type.toLowerCase().includes("live") || l.type.toLowerCase().includes("blog"));
const githubLink = project.links?.find((l) => l.type.toLowerCase().includes("github"));
const displayDomain = liveLink ? liveLink.url.replace(/^https?:\/\//, "").replace(/\/$/, "") : `${project.heading.toLowerCase().replace(/\s+/g, "")}.chhatreshkhatri.com`;
---

<article class="spotlight-card relative group rounded-2xl overflow-hidden bg-white/40 dark:bg-surface-card/60 backdrop-blur-md border border-black/5 dark:border-white/10 shadow-xl hover:shadow-2xl hover:-translate-y-1 hover:border-brand-primary/40 transition-all duration-300 ease-out flex flex-col h-full">
  <div class="absolute inset-0 rounded-2xl bg-linear-to-r from-brand-primary/10 via-purple-500/5 to-brand-secondary/10 opacity-60 transition-opacity duration-300 group-hover:opacity-100 -z-10" aria-hidden="true" />
  
  <!-- Visual Screenshot Frame with Browser Mockup Header -->
  <div class="relative z-10 w-full border-b border-black/10 dark:border-white/10 overflow-hidden transition-colors duration-300 ease-out">
    <div class="flex items-center justify-between gap-2 px-3.5 py-2 bg-white/70 dark:bg-surface-card/40 border-b border-black/10 dark:border-white/10 select-none min-w-0 transition-colors duration-300 ease-out">
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
      </div>
      <a 
        href={liveLink?.url || `/projects#${projectSlug}`}
        target={liveLink ? "_blank" : undefined}
        rel={liveLink ? "noopener noreferrer" : undefined}
        title={`Visit ${project.heading}`}
        class="flex items-center text-[10px] font-mono text-gray-500 dark:text-gray-400 hover:text-brand-primary dark:hover:text-brand-secondary hover:border-brand-primary/30 dark:hover:border-brand-primary/30 hover:scale-105 transition-all duration-200 truncate min-w-0 px-2 py-0.5 rounded bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/5 cursor-pointer"
      >
        {displayDomain}
      </a>
      <div class="w-5 shrink-0"></div>
    </div>

    <a 
      href={liveLink?.url || `/projects#${projectSlug}`} 
      target={liveLink ? "_blank" : undefined} 
      rel={liveLink ? "noopener noreferrer" : undefined} 
      class="block relative h-48 sm:h-52 w-full overflow-hidden group/img cursor-pointer bg-gray-900/5 dark:bg-black/20"
      aria-label={`View ${project.heading} live application`}
    >
      <img 
        src={project.image} 
        alt={`Screenshot of ${project.heading} web platform`}
        class="w-full h-full object-cover object-top transition-all duration-1800 ease-in-out group-hover/img:object-bottom"
        loading="lazy"
        width="800"
        height="500"
      />
      <div class="absolute inset-0 bg-linear-to-t from-black/25 via-transparent to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity pointer-events-none" />
    </a>
  </div>

  <!-- Content Section (Concise, punchy, not a wall of text) -->
  <div class="relative z-10 p-5 sm:p-6 flex flex-col flex-1 justify-between gap-4">
    <div class="flex flex-col gap-2">
      <h3 class="text-lg sm:text-xl font-bold bg-linear-to-r from-heading-start to-heading-end bg-clip-text text-transparent group-hover:brightness-110 transition-all duration-300">
        {project.heading}
      </h3>
      <h4 class="text-xs font-semibold text-gray-500 dark:text-gray-400 line-clamp-1 transition-colors duration-300 ease-out">
        {project.subHeading}
      </h4>
      <p class="text-xs sm:text-sm text-gray-700 dark:text-gray-300 leading-relaxed line-clamp-2 mt-0.5 transition-colors duration-300 ease-out">
        {project.description}
      </p>
    </div>

    <!-- Tech Stack Pills with Icons -->
    {project.tags && project.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-2 border-t border-black/5 dark:border-white/10" aria-label={`${project.heading} technologies`}>
        {project.tags.slice(0, 4).map((tag) => (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-medium bg-black/5 dark:bg-white/5 text-gray-700 dark:text-gray-300 border border-black/5 dark:border-white/10 hover:border-brand-primary/30 dark:hover:border-brand-primary/30 hover:bg-black/8 dark:hover:bg-white/8 hover:scale-105 transition-all duration-300 ease-out cursor-default">
            {tag.url && <img src={tag.url} alt="" class="w-3 h-3 object-contain transition-transform duration-200 group-hover:scale-110" width="12" height="12" loading="lazy" aria-hidden="true" />}
            <span>{tag.name}</span>
          </span>
        ))}
      </div>
    )}

    <!-- Action Links -->
    <div class="flex items-center justify-between pt-3 border-t border-black/5 dark:border-white/10 text-xs font-semibold transition-colors duration-300 ease-out">
      <div class="flex items-center gap-3">
        {liveLink && (
          <a href={liveLink.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-brand-primary dark:text-brand-secondary hover:underline group/live">
            <span>Live App</span>
            <span aria-hidden="true" class="transition-transform duration-200 group-hover/live:translate-x-0.5 group-hover/live:-translate-y-0.5">↗</span>
          </a>
        )}
        {githubLink && (
          <a href={githubLink.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors group/code">
            <span>Code</span>
            <span aria-hidden="true" class="transition-transform duration-200 group-hover/code:translate-x-0.5 group-hover/code:-translate-y-0.5">↗</span>
          </a>
        )}
      </div>
      <a href={`/projects#${projectSlug}`} class="inline-flex items-center gap-1 text-brand-primary dark:text-brand-secondary hover:underline group/case">
        <span>Case Study</span>
        <span aria-hidden="true" class="transition-transform duration-200 group-hover/case:translate-x-1">→</span>
      </a>
    </div>
  </div>
</article>
