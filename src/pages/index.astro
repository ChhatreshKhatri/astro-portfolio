---
import RootLayout from "../layouts/RootLayout.astro";
import SectionHeading from "../components/Heading.astro";
import Loading from "../components/Loading.astro";
import Hero from "../components/Hero.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import { getHomeData } from "../services/api";

const homeData = await getHomeData();
const featuredProjects = homeData?.featuredProjects || [];
const enterpriseHighlight = homeData?.enterpriseHighlight;
const capabilities = homeData?.capabilities || [];
---

<RootLayout 
  title="Chhatresh Khatri | Full-Stack Software Engineer & AI Product Builder" 
  description="Full-Stack Software Engineer specializing in modern web applications (Next.js, React, TypeScript), resilient backend systems (.NET Core, Node.js, SQL), and intelligent AI product engineering." 
  keywords="Chhatresh Khatri, Full Stack Developer, Software Engineer, Next.js, React, TypeScript, .NET Core, Node.js, Agentic AI, Cloudflare"
  schemaType="WebPage"
>
  <SectionHeading as="div">Welcome to my Portfolio</SectionHeading>
  {
    homeData ? (
      <div class="w-full flex flex-col gap-12 md:gap-16">
        <!-- Main Hero Showcase -->
        <Hero data={homeData} />

        <!-- Key Impact & Statistics -->
        {homeData.stats && homeData.stats.length > 0 && (
          <section class="w-full grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 transition duration-300 ease-out starting:opacity-0 starting:translate-y-2.5" aria-label="Key highlights and statistics">
            {homeData.stats.map((stat) => (
              <div class="spotlight-card relative group/stat p-6 rounded-2xl bg-white/40 dark:bg-surface-card/60 border border-black/5 dark:border-white/10 shadow-xl backdrop-blur-md flex flex-col items-center justify-center text-center hover:shadow-2xl hover:-translate-y-1 hover:border-brand-primary/40 transition-all duration-300 ease-out cursor-pointer">
                <div class="absolute inset-0 rounded-2xl bg-linear-to-r from-brand-primary/10 via-purple-500/5 to-brand-secondary/10 opacity-60 transition-opacity duration-300 group-hover/stat:opacity-100 -z-10" aria-hidden="true" />
                <span class="relative z-10 text-3xl md:text-4xl lg:text-5xl font-extrabold bg-linear-to-r from-heading-start to-heading-end bg-clip-text text-transparent mb-1 drop-shadow-xs group-hover/stat:scale-110 transition-transform duration-300">{stat.value}</span>
                <span class="relative z-10 text-xs md:text-sm font-semibold tracking-wide text-gray-600 dark:text-gray-300 uppercase transition-colors duration-300 ease-out">{stat.label}</span>
              </div>
            ))}
          </section>
        )}

        <!-- Visual Featured Projects Showcase (Centered Header - Preview Grid) -->
        {featuredProjects.length > 0 && (
          <section class="w-full flex flex-col gap-8 transition duration-300 ease-out starting:opacity-0 starting:translate-y-2.5" aria-labelledby="featured-projects-heading">
            <div class="flex justify-center items-center text-center pb-2">
              <SectionHeading as="h2" id="featured-projects-heading" class="starting:scale-[0.98]">Selected Work</SectionHeading>
            </div>

            <!-- Visual 3-Column Preview Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
              {featuredProjects.map((project, index) => (
                <FeaturedProject project={project} index={index} />
              ))}
            </div>

            <div class="flex justify-center pt-2">
              <div class="items-center justify-center p-px rounded-xl bg-linear-to-r from-brand-primary/40 to-brand-secondary/40 hover:from-brand-primary hover:to-brand-secondary transition-all duration-300 hover:scale-105 hover:-translate-y-0.5 shadow-xs cursor-pointer group/explore">
                <a 
                  href="/projects" 
                  class="flex justify-center items-center py-2.5 px-6 gap-x-2 rounded-xl whitespace-nowrap bg-white dark:bg-surface-card hover:bg-opacity-95 text-xs sm:text-sm font-semibold text-gray-800 dark:text-gray-100 transition-all duration-300"
                >
                  <span>Explore All Projects</span>
                  <span class="transition-transform duration-200 group-hover/explore:translate-x-1">→</span>
                </a>
              </div>
            </div>
          </section>
        )}

        <!-- Enterprise Credibility Highlight Banner (Clean & Simple) -->
        {enterpriseHighlight && (
          <section class="w-full spotlight-card relative group rounded-2xl p-6 sm:p-8 md:p-10 bg-white/40 dark:bg-surface-card/60 backdrop-blur-md border border-black/5 dark:border-white/10 shadow-xl hover:shadow-2xl hover:border-brand-primary/40 transition-all duration-300 ease-out starting:opacity-0 starting:translate-y-2.5" aria-label="Enterprise engineering highlights">
            <div class="absolute inset-0 rounded-2xl bg-linear-to-r from-brand-primary/10 via-purple-500/5 to-brand-secondary/10 opacity-60 transition-opacity duration-300 group-hover:opacity-100 -z-10" aria-hidden="true" />
            
            <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 w-full">
              <div class="flex flex-col items-start gap-4 flex-1">
                <div class="flex items-center gap-2">
                  <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-primary dark:text-brand-secondary">{enterpriseHighlight.badge}</span>
                </div>

                <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold bg-linear-to-r from-heading-start to-heading-end bg-clip-text text-transparent group-hover:brightness-110 transition-all duration-300">
                  {enterpriseHighlight.title}
                </h2>

                <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 ease-out">
                  {enterpriseHighlight.description}
                </p>

                {enterpriseHighlight.highlights && enterpriseHighlight.highlights.length > 0 && (
                  <div class="flex flex-wrap gap-2 pt-1 text-xs font-semibold text-brand-primary dark:text-brand-secondary">
                    {enterpriseHighlight.highlights.map((item) => (
                      <span class="px-2.5 py-1 rounded-lg bg-black/5 dark:bg-white/5 border border-black/5 dark:border-white/10 hover:border-brand-primary/30 dark:hover:border-brand-primary/30 hover:bg-black/8 dark:hover:bg-white/8 hover:scale-105 transition-all duration-200 cursor-default">
                        {item}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="shrink-0 self-start lg:self-center">
                <div class="inline-flex items-center justify-center p-px rounded-xl bg-linear-to-r from-brand-primary/40 to-brand-secondary/40 hover:from-brand-primary hover:to-brand-secondary transition-all duration-300 hover:scale-105 hover:-translate-y-0.5 shadow-xs cursor-pointer group/cta">
                  <a 
                    href={enterpriseHighlight.linkUrl} 
                    class="flex justify-center items-center py-2.5 px-6 gap-x-2 rounded-xl whitespace-nowrap bg-white dark:bg-surface-card hover:bg-opacity-95 text-xs sm:text-sm font-semibold text-gray-800 dark:text-gray-100 transition-all duration-300"
                  >
                    <span>{enterpriseHighlight.linkText || "Full Career Timeline"}</span>
                    <span class="transition-transform duration-200 group-hover/cta:translate-x-1">→</span>
                  </a>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Core Capabilities Showcase -->
        {capabilities.length > 0 && (
          <section class="w-full flex flex-col gap-6 transition duration-300 ease-out starting:opacity-0 starting:translate-y-2.5" aria-labelledby="capabilities-heading">
            <div class="flex justify-center items-center text-center pb-2">
              <SectionHeading as="h2" id="capabilities-heading" class="starting:scale-[0.98]">Core Capabilities</SectionHeading>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
              {capabilities.map((cap) => (
                <div class="spotlight-card relative group p-6 rounded-2xl bg-white/40 dark:bg-surface-card/60 border border-black/5 dark:border-white/10 shadow-xl hover:shadow-2xl hover:-translate-y-1 hover:border-brand-primary/40 backdrop-blur-md flex flex-col gap-3 transition-all duration-300 ease-out">
                  <div class="absolute inset-0 rounded-2xl bg-linear-to-r from-brand-primary/10 via-purple-500/5 to-brand-secondary/10 opacity-60 transition-opacity duration-300 group-hover:opacity-100 -z-10" aria-hidden="true" />
                  <div class="flex items-center gap-3">
                    <span class="text-2xl shrink-0 group-hover:scale-110 transition-transform duration-300">{cap.icon}</span>
                    <h3 class="text-base xs:text-lg sm:text-xl font-bold bg-linear-to-r from-heading-start to-heading-end bg-clip-text text-transparent leading-snug group-hover:brightness-110 transition-all duration-300">
                      {cap.title}
                    </h3>
                  </div>
                  <p class="text-xs md:text-sm text-gray-700 dark:text-gray-300 leading-relaxed transition-colors duration-300 ease-out">
                    {cap.description}
                  </p>
                  {cap.tags && cap.tags.length > 0 && (
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 pt-2 mt-auto text-[11px] font-semibold text-brand-primary dark:text-brand-secondary">
                      {cap.tags.map((tag, tIndex) => (
                        <span class="inline-flex items-center gap-2">
                          <span class="hover:text-brand-secondary transition-colors cursor-default">{tag}</span>
                          {tIndex < cap.tags!.length - 1 && (
                            <span class="text-gray-400 dark:text-gray-600 select-none font-normal" aria-hidden="true">•</span>
                          )}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    ) : (
      <Loading />
    )
  }
</RootLayout>
