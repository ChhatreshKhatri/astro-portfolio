---
import RootLayout from "../layouts/RootLayout.astro";
import SectionHeading from "../components/Heading.astro";
import Loading from "../components/Loading.astro";
import Hero from "../components/Hero.astro";
import { getHomeData } from "../services/api";

const data = await getHomeData();
---

<RootLayout title="Chhatresh Khatri | Portfolio" description="Chhatresh Khatri Portfolio. Software Engineer and Full Stack Developer passionate about latest trends in the tech industry. Crafting innovation with code." keywords="">
  <SectionHeading as="div">Welcome to my Portfolio</SectionHeading>
  {
    data ? (
      <div class="w-full flex flex-col gap-8 md:gap-12">
        <Hero data={data} />

        {data.stats && (
          <section class="w-full grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 transition duration-500 ease-out delay-600 starting:opacity-0 starting:translate-y-4" aria-label="Key highlights and statistics">
            {data.stats.map((stat) => (
              <div class="relative group/stat p-6 rounded-2xl bg-white/40 dark:bg-darker/60 border border-black/5 dark:border-white/10 shadow-lg backdrop-blur-md flex flex-col items-center justify-center text-center hover:shadow-2xl hover:-translate-y-1 hover:border-ck1/40 transition-all duration-300 cursor-pointer">
                <div class="absolute inset-0 bg-linear-to-r from-ck1/5 to-ck2/5 rounded-2xl opacity-0 group-hover/stat:opacity-100 transition-opacity duration-300" aria-hidden="true" />
                <span class="text-3xl md:text-4xl lg:text-5xl font-extrabold bg-linear-to-r from-hd1 to-hd2 bg-clip-text text-transparent mb-1 drop-shadow-xs group-hover/stat:scale-110 transition-transform duration-300">{stat.value}</span>
                <span class="text-xs md:text-sm font-semibold tracking-wide text-gray-600 dark:text-gray-300 uppercase">{stat.label}</span>
              </div>
            ))}
          </section>
        )}
      </div>
    ) : (
      <Loading />
    )
  }
</RootLayout>
