---
import LinkButton from "../components/LinkButton.astro";
import RootLayout from "../layouts/RootLayout.astro";
import SectionHeading from "../components/Heading.astro";
import Loading from "../components/Loading.astro";
import { getHomeData } from "../services/api";

const data = await getHomeData();
---

<RootLayout title="Chhatresh Khatri | Portfolio" description="Chhatresh Khatri Portfolio. Full stack Web Developer passionate about latest trends in the tech industry. Crafting innovation with code." keywords="" page="">
  <SectionHeading as="div">Welcome to my Portfolio</SectionHeading>
  {
    data ? (
      <div class="w-full flex flex-col gap-8 md:gap-12">
        <section
          class="hero-section relative group grid grid-cols-1 w-full xl:grid-cols-12 p-6 xs:p-8 md:p-10 gap-8 xl:gap-12 rounded-2xl bg-white/40 dark:bg-darker/60 backdrop-blur-md border border-black/5 dark:border-white/10 shadow-2xl transition duration-500 ease-out delay-100 starting:opacity-0 starting:translate-y-2.5 items-center hover:border-ck1/40"
          aria-labelledby="hero-heading">
          <div class="absolute inset-0 rounded-2xl bg-linear-to-r from-ck1/10 via-purple-500/5 to-ck2/10 opacity-60 transition-opacity duration-500 group-hover:opacity-100 -z-10" aria-hidden="true" />

          <article class="relative order-2 xl:order-1 xl:col-span-8 flex flex-col justify-center items-center xl:items-start text-center xl:text-left gap-4 md:gap-6 z-10">
            <div class="w-full flex flex-col items-center xl:items-start gap-3 md:gap-4">
              <h1
                id="hero-heading"
                class="hero-heading flex w-fit text-xl xxs:text-2xl xs:text-3xl sm:text-4xl md:text-4xl lg:text-5xl xl:text-5xl xxl:text-5xl font-extrabold bg-linear-to-r from-ck1 to-ck2 bg-clip-text text-transparent leading-tight whitespace-nowrap transition duration-400 ease-out delay-200 starting:opacity-0 starting:translate-y-2.5">
                {data.intro}
              </h1>

              <div
                id="autoTypeContainer"
                data-roles={JSON.stringify(data.roles || ["Software Engineer", "Full Stack Developer", "Next.js Specialist"])}
                class="hero-typewriter text-lg xxs:text-xl xs:text-2xl sm:text-3xl md:text-3xl lg:text-4xl xl:text-4xl xxl:text-4xl font-bold min-h-[1.5em] leading-relaxed transition duration-400 ease-out delay-300 starting:opacity-0 starting:translate-y-2.5">
                <span id="autoType" class="bg-linear-to-r from-sub1 to-sub2 bg-clip-text text-transparent">Software Engineer</span>
                <span id="cursor" class="inline-block w-1 h-[1em] bg-linear-to-b from-sub1 to-sub2 align-middle animate-pulse ml-1" />
              </div>

              <p class="hero-description text-base xs:text-lg md:text-xl text-gray-700 dark:text-gray-300 text-justify leading-relaxed transition duration-400 ease-out delay-400 starting:opacity-0 starting:translate-y-2.5">{data.content}</p>

              <div class="hero-links flex flex-wrap justify-center xl:justify-start items-center gap-3 pt-2 w-full transition duration-400 ease-out delay-500 starting:opacity-0 starting:translate-y-2.5" aria-label="Social and portfolio links">
                {data.links.map((link, index) => (
                  <div class="hero-link" data-index={index}>
                    <LinkButton name={link.type} link={link.url} imageUrl={link.icon} pos={index % 2} />
                  </div>
                ))}
              </div>
            </div>
          </article>

          <aside class="hero-image order-1 xl:order-2 xl:col-span-4 flex justify-center items-center transition duration-500 ease-out delay-200 starting:opacity-0 starting:scale-[0.95]">
            <div class="relative w-full flex justify-center items-center group/img py-2 md:py-4">
              <figure class="relative z-10 w-full h-full flex justify-center items-center">
                <img
                  title="Chhatresh Khatri"
                  src={data.pic}
                  alt="Chhatresh Khatri"
                  class="w-full max-w-[260px] sm:max-w-[280px] md:max-w-[300px] xl:max-w-[260px] xxl:max-w-[290px] mx-auto rounded-2xl drop-shadow-2xl transition-transform duration-500 group-hover/img:scale-[1.03] object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  width="808"
                  height="1080"
                />
              </figure>
            </div>
          </aside>

          {data.highlights && (
            <footer class="order-3 xl:order-3 xl:col-span-12 w-full pt-4 md:pt-6 border-t border-black/5 dark:border-white/10 flex flex-col items-center justify-center gap-3 transition duration-400 ease-out delay-500 starting:opacity-0 starting:translate-y-2.5">
              <div class="w-full flex flex-wrap items-center justify-center gap-2.5 md:gap-3" role="list" aria-label="Core skills highlights">
                {data.highlights.map((highlight, index) => {
                  const name = typeof highlight === "string" ? highlight : highlight.name;
                  const icon = typeof highlight === "string" ? null : highlight.icon;
                  return (
                    <div title={name} class="items-center justify-center p-px rounded-xl bg-linear-to-r from-ck1/40 to-ck2/40 hover:from-ck1 hover:to-ck2 transition-all duration-300 hover:scale-105 hover:-translate-y-0.5 shadow-xs cursor-default" role="listitem">
                      <div class="flex justify-center items-center py-1.5 px-3.5 gap-x-2 rounded-xl whitespace-nowrap bg-white dark:bg-darker hover:bg-opacity-95 transition-all duration-300">
                        {icon && <img title={name} src={icon} alt="" class="w-5 h-5 md:w-6 md:h-6 transition-transform duration-300 group-hover:scale-110" loading={index === 0 ? "eager" : "lazy"} width="24" height="24" aria-hidden="true" />}
                        <span class="text-xs md:text-sm font-semibold text-gray-800 dark:text-gray-100">{name}</span>
                      </div>
                    </div>
                  );
                })}
              </div>
            </footer>
          )}
        </section>

        {data.stats && (
          <section class="w-full grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 transition duration-500 ease-out delay-600 starting:opacity-0 starting:translate-y-4" aria-label="Key highlights and statistics">
            {data.stats.map((stat) => (
              <div class="relative group/stat p-6 rounded-2xl bg-white/40 dark:bg-darker/60 border border-black/5 dark:border-white/10 shadow-lg backdrop-blur-md flex flex-col items-center justify-center text-center hover:shadow-2xl hover:-translate-y-1 hover:border-ck1/40 transition-all duration-300">
                <div class="absolute inset-0 bg-linear-to-r from-ck1/5 to-ck2/5 rounded-2xl opacity-0 group-hover/stat:opacity-100 transition-opacity duration-300" aria-hidden="true" />
                <span class="text-3xl md:text-4xl lg:text-5xl font-extrabold bg-linear-to-r from-hd1 to-hd2 bg-clip-text text-transparent mb-1 drop-shadow-xs group-hover/stat:scale-110 transition-transform duration-300">{stat.value}</span>
                <span class="text-xs md:text-sm font-semibold tracking-wide text-gray-600 dark:text-gray-300 uppercase">{stat.label}</span>
              </div>
            ))}
          </section>
        )}
      </div>
    ) : (
      <Loading />
    )
  }
</RootLayout>

<script>
  const autoTypeElement = document.querySelector("#autoType");
  const container = document.querySelector("#autoTypeContainer") as HTMLElement | null;
  let words = ["Software Engineer", "Full Stack Developer", "Next.js Specialist", ".NET Core Architect"];

  if (container && container.dataset.roles) {
    try {
      words = JSON.parse(container.dataset.roles);
    } catch (e) {
      console.error("Error parsing roles", e);
    }
  }

  let wordIndex = 0;
  let charIndex = 0;

  function typeChar() {
    if (!autoTypeElement) return;
    if (charIndex < words[wordIndex].length) {
      autoTypeElement.textContent += words[wordIndex][charIndex++];
      setTimeout(typeChar, 100);
    } else {
      setTimeout(deleteChar, 2000);
    }
  }

  function deleteChar() {
    if (!autoTypeElement) return;
    if (charIndex > 0) {
      autoTypeElement.textContent = words[wordIndex].substring(0, --charIndex);
      setTimeout(deleteChar, 50);
    } else {
      wordIndex = (wordIndex + 1) % words.length;
      setTimeout(typeChar, 120);
    }
  }

  if (autoTypeElement) {
    autoTypeElement.textContent = "";
    setTimeout(typeChar, 500);
  }
</script>
