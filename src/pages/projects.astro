---
import RootLayout from "../layouts/RootLayout.astro";
import Loading from "../components/Loading.astro";
import { getProjectsData } from "../services/api";
import SectionHeading from "../components/Heading.astro";
import ProjectCard from "../components/ProjectCard.astro";

const data = await getProjectsData();
const projects = data?.projects || [];
---

<RootLayout 
  title="Projects Showcase | Chhatresh Khatri — Full-Stack & AI Apps" 
  description="Explore full-stack web applications, cloud platforms, and global award-winning projects crafted by Chhatresh Khatri using Next.js, .NET Core, React, TypeScript, and Node.js." 
  keywords="Chhatresh Khatri Projects, Web Applications, Award Winning Projects, Next.js Showcase, React Apps, Full Stack Projects, Open Source Tools, .NET Core"
>
  <SectionHeading>My Projects</SectionHeading>
  {
    data ? (
      <div class="w-full flex flex-col gap-8 md:gap-10 lg:gap-12">
        {projects.length > 0 && (
          <section class="flex flex-col gap-8 md:gap-10 lg:gap-12 transition duration-300 ease-out starting:opacity-0" aria-label="Projects showcase">
            {projects.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </section>
        )}
      </div>
    ) : (
      <Loading label="Loading projects" />
    )
  }
</RootLayout>
