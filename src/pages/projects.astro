---
import RootLayout from "../layouts/RootLayout.astro";
import Loading from "../components/Loading.astro";
import { getProjectsData } from "../services/api";
import SectionHeading from "../components/Heading.astro";
import ProjectCard from "../components/ProjectCard.astro";

const data = await getProjectsData();

const itemListSchema = data ? {
  "@type": "ItemList",
  "@id": `${Astro.site?.origin || "https://www.chhatreshkhatri.com"}/projects#itemlist`,
  "numberOfItems": data.projects.length,
  "itemListElement": data.projects.map((project: any, index: number) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": project.heading,
    "description": project.description,
    "url": project.links?.[0]?.url || Astro.site?.origin || "https://www.chhatreshkhatri.com"
  }))
} : undefined;
---

<RootLayout title="Chhatresh Khatri | Projects" description="Chhatresh Khatri Projects. Explore a collection of diverse projects, discover their unique features and access relevant links for more information." keywords="" schemaType="CollectionPage" additionalSchema={itemListSchema}>
  <SectionHeading>My Projects</SectionHeading>
  {
    data ? (
      <div class="w-full flex flex-col gap-10 md:gap-14">
        <!-- Projects List -->
        <div class="flex flex-col gap-12 md:gap-16">
          {data.projects.map((project: any, index: number) => (
            <ProjectCard project={project} index={index} />
          ))}
        </div>
      </div>
    ) : (
      <Loading label="Loading projects" />
    )
  }
</RootLayout>
