---
import RootLayout from "../layouts/RootLayout.astro";
---

<RootLayout title="404 - Page Not Found | Chhatresh Khatri" description="The page you're looking for doesn't exist." keywords="" page="404">
  <div class="flex flex-col items-center justify-center min-h-[60vh] gap-6">
    <div class="relative group">
      <div class="absolute inset-0 rounded-lg bg-linear-to-r from-blue2/50 to-green2/50 opacity-20 transition-opacity duration-500 group-hover:opacity-50"></div>
      <div class="relative flex flex-col items-center justify-center gap-4 p-8 rounded-lg">
        <h1 class="text-6xl md:text-8xl font-bold bg-linear-to-r from-hd1 to-hd2 bg-clip-text text-transparent">404</h1>
        <h2 class="text-2xl md:text-4xl font-bold bg-linear-to-r from-sub1 to-sub2 bg-clip-text text-transparent text-center">Page Not Found</h2>
        <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 text-center max-w-md">The page you're looking for doesn't exist or has been moved.</p>
        <div class="flex items-center justify-center p-px rounded-xl bg-linear-to-r from-hd1/40 to-hd2/40 hover:from-hd1 hover:to-hd2 mt-4 transition-all duration-300 hover:scale-105 hover:-translate-y-0.5 shadow-xs cursor-pointer">
          <a href="/" class="flex justify-center items-center py-2 px-6 rounded-xl text-lg font-semibold text-gray-800 dark:text-gray-100 bg-white dark:bg-darker hover:bg-opacity-95 transition-all duration-300 cursor-pointer">
            Return Home
          </a>
        </div>
      </div>
    </div>
  </div>
</RootLayout>
