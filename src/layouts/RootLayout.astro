---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: string;
  schemaType?: string;
  additionalSchema?: any;
}

const { 
  title = "Chhatresh Khatri | Portfolio", 
  description = "Full stack developer building modern web apps.", 
  keywords = "", 
  ogType = "website",
  schemaType = "WebPage",
  additionalSchema
} = Astro.props;

// Fallback to production URL if Astro.site isn't configured
const siteUrl = Astro.site?.origin || "https://www.chhatreshkhatri.com";

// Normalize pathname to strip trailing slashes (except for the root '/')
// This is critical for SEO so /about and /about/ don't generate two different canonical URLs!
const cleanPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalURL = new URL(cleanPath, siteUrl).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  "name": "Chhatresh Khatri",
  "givenName": "Chhatresh",
  "familyName": "Khatri",
  "url": siteUrl,
  "image": "https://cdn.chhatreshkhatri.com/images/ChhatreshKhatri.webp",
  "email": "ck@chhatreshkhatri.com",
  "jobTitle": "Software Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "LTM",
  },
  "description": "Software Engineer with a passion for building modern, user-friendly websites and applications.",
  "knowsAbout": [
    "JavaScript", "TypeScript", "React", "Next.js", "Astro", "Node.js",
    "Express.js", "HTML", "CSS", "Tailwind CSS", "MongoDB", "MySQL",
    "Firebase", "Git", "C", "C++", "Java", "Linux",
    "Full Stack Development", "Web Development", "Software Engineering"
  ],
  "sameAs": [
    "https://github.com/ChhatreshKhatri",
    "https://www.linkedin.com/in/chhatreshkhatri",
    "https://x.com/chhatreshkhatri",
    "https://www.instagram.com/chhatreshkhatri/",
    "https://www.facebook.com/chhatreshkhatri/",
    "https://www.youtube.com/@chhatreshkhatri",
    "https://leetcode.com/u/chhatreshkhatri/",
    "https://www.geeksforgeeks.org/profile/chhatreshkhatri",

  ]
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "url": siteUrl,
  "name": "Chhatresh Khatri Portfolio",
  "description": "Portfolio website of Chhatresh Khatri — Software Engineer and Full Stack Developer.",
  "publisher": {
    "@id": `${siteUrl}/#person`
  },
  "inLanguage": "en"
};

const pageSchema = {
  "@type": schemaType,
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": {
    "@id": `${siteUrl}/#website`
  },
  "about": schemaType === "ProfilePage" ? {
    "@id": `${siteUrl}/#person`
  } : undefined,
  "mainEntity": schemaType === "CollectionPage" ? {
    "@id": `${canonicalURL}#itemlist`
  } : undefined
};

const graph = [personSchema, websiteSchema, pageSchema];
if (additionalSchema) {
  graph.push(additionalSchema);
}

const graphSchema = {
  "@context": "https://schema.org",
  "@graph": graph
};
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={["Chhatresh Khatri", "Software Engineer","Portfolio","About","Projects","Full Stack Developer","Web Development","Web Designer","Website","Code","Innovation","Astro","Next.JS","frontend", keywords].filter(Boolean).join(",")} />
    <meta name="author" content="Chhatresh Khatri" />
    <link rel="shortcut icon" type="image/svg+xml" href="https://cdn.chhatreshkhatri.com/icons/icon.svg" />
    <link rel="icon" type="image/x-icon" href="https://cdn.chhatreshkhatri.com/icons/favicon.ico" />
    <link rel="apple-touch-icon" href="https://cdn.chhatreshkhatri.com/icons/apple-icon.png" />
    <link rel="mask-icon" type="image/svg+xml" href="https://cdn.chhatreshkhatri.com/icons/icon.svg" color="#191919" />
    <link rel="manifest" href="/app.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={title + " RSS Feed"} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#191919" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={`chhatreshkhatri`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content="https://cdn.chhatreshkhatri.com/icons/opengraph-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Chhatresh Khatri - Software Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@chhatreshkhatri" />
    <meta name="twitter:site" content="@chhatreshkhatri" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cdn.chhatreshkhatri.com/icons/opengraph-image.png" />
    
    <!-- SEO Control: Block preview domain from search engines -->
    {Astro.url.hostname === 'preview.chhatreshkhatri.com' ? (
      <>
        <meta name="robots" content="noindex, nofollow" />
        <link rel="canonical" href={canonicalURL} />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalURL} />
      </>
    )}
    
    <!-- Early Resource Hints for Performance -->
    <link rel="preconnect" href="https://cdn.chhatreshkhatri.com" crossorigin />
    <link rel="dns-prefetch" href="https://visits.chhatreshkhatri.com" />
    <link rel="preload" as="image" type="image/svg+xml" href="https://cdn.chhatreshkhatri.com/images/ChhatreshKhatri.svg" />
    
    <!-- Font Preloading - Only preload regular weight for LCP -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Poppins.woff2" crossorigin="anonymous" />
    
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  </head>
  <body class="w-full min-h-screen flex flex-col bg-light text-darked dark:bg-dark dark:text-light font-display">
    <Header />
    <main id="main" class="w-full h-full flex items-center flex-col justify-center font-medium px-2 xxs:px-3 xs:px-6 md:px-12 lg:px-20 py-20 gap-y-8">
      <slot /><!-- content is injected here -->
    </main>
    <Footer />
  </body>
</html>
<script>
  const favicon = document.querySelector('link[rel="icon"]');
  if (favicon) {
    document.addEventListener("visibilitychange", () => {
      favicon.setAttribute("href", 
        `https://cdn.chhatreshkhatri.com/icons/${document.hidden ? "icon-hidden.svg" : "favicon.ico"}`
      );
    });
  }
</script>
