---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchPalette from "../components/SearchPalette.astro";
import { ClientRouter } from 'astro:transitions';

import type { RootLayoutProps as Props } from "../types";

const { 
  title = "Chhatresh Khatri | Full-Stack Software Engineer", 
  description = "Full-Stack Software Engineer specializing in modern web applications, scalable systems, and Agentic AI solutions.", 
  keywords = "", 
  ogType = "website",
  ogImage = "https://cdn.chhatreshkhatri.com/icons/opengraph-image.png",
  schemaType = "WebPage",
  noindex = false
} = Astro.props;

const siteUrl = Astro.site?.origin ?? Astro.url.origin;

// Normalize pathname to strip trailing slashes (except for the root '/')
// This is critical for SEO so /about and /about/ don't generate two different canonical URLs!
const cleanPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalURL = new URL(cleanPath, Astro.site ?? Astro.url).href;

import { generateGraphSchema } from "../utils/schema";

const graphSchema = generateGraphSchema({
  schemaType,
  canonicalURL,
  siteUrl,
  title,
  description
});

const defaultKeywords = [
  "Chhatresh Khatri",
  "Software Engineer",
  "Full Stack Developer",
  "React.js",
  "Next.js",
  "TypeScript",
  "Node.js",
  "Tailwind CSS",
  "Cloudflare",
  "Agentic AI",
  "Web Development",
  "Portfolio"
];

const mergedKeywords = Array.from(new Set([
  ...defaultKeywords,
  ...(keywords ? keywords.split(",").map((k: string) => k.trim()) : [])
])).filter(Boolean).join(", ");
---

<html lang="en" class="scroll-smooth">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={mergedKeywords} />
    <meta name="author" content="Chhatresh Khatri" />
    <link rel="shortcut icon" type="image/svg+xml" href="https://cdn.chhatreshkhatri.com/icons/icon.svg" />
    <link rel="icon" type="image/x-icon" href="https://cdn.chhatreshkhatri.com/icons/favicon.ico" />
    <link rel="apple-touch-icon" href="https://cdn.chhatreshkhatri.com/icons/apple-icon.png" />
    <link rel="mask-icon" type="image/svg+xml" href="https://cdn.chhatreshkhatri.com/icons/icon.svg" color="#0f1117" />
    <link rel="manifest" href="/app.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={title + " RSS Feed"} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1117" media="(prefers-color-scheme: dark)" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Chhatresh Khatri" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@chhatreshkhatri" />
    <meta name="twitter:site" content="@chhatreshkhatri" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    
    <!-- SEO Robots Directive -->
    {noindex || Astro.url.hostname === 'preview.chhatreshkhatri.com' ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <link rel="canonical" href={canonicalURL} />
      </>
    )}
    
    <!-- Font Preloading - Only preload regular weight for LCP -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Poppins.woff2" crossorigin="anonymous" />
    
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  </head>
  <body class="w-full min-h-screen flex flex-col bg-surface-light text-surface-elevated dark:bg-surface-base dark:text-surface-light font-display relative selection:bg-brand-primary/20 selection:text-brand-primary transition-colors duration-300 ease-out">
    <!-- Ambient Aurora Glow -->
    <div class="aurora-container" aria-hidden="true">
      <div class="aurora-glow-1"></div>
      <div class="aurora-glow-2"></div>
    </div>

    <!-- Global Search Palette -->
    <SearchPalette transition:persist />

    <Header transition:persist />
    <main id="main" class="relative z-10 w-full h-full flex items-center flex-col justify-center font-medium px-2 xxs:px-3 xs:px-6 md:px-12 lg:px-20 pt-24 md:pt-28 lg:pt-30 pb-12 sm:pb-16 gap-y-4 md:gap-y-5">
      <slot /><!-- content is injected here -->
    </main>
    <Footer transition:persist />
  </body>
</html>
<script>
  // Dynamic spotlight card cursor tracking with Astro ClientRouter support
  const handlePointerMove = (e: MouseEvent) => {
    const card = (e.target as HTMLElement | null)?.closest?.(".spotlight-card") as HTMLElement | null;
    if (card) {
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
      card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
    }
  };

  window.addEventListener("pointermove", handlePointerMove, { passive: true });

  document.addEventListener("visibilitychange", () => {
    const favicon = document.querySelector('link[rel="icon"]');
    if (favicon) {
      favicon.setAttribute("href", 
        `https://cdn.chhatreshkhatri.com/icons/${document.hidden ? "icon-hidden.svg" : "favicon.ico"}`
      );
    }
  });
</script>
